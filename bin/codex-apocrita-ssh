#!/usr/bin/env bash
# Optional local compatibility shim; install as ~/.local/bin/ssh.
# All nonmatching invocations are delegated with their original argv.
# macOS Bash 3.2 treats empty arrays as unset under nounset.
set -eo pipefail

real_ssh="${CODEX_APOCRITA_SSH_REAL:-}"
if [[ -z "$real_ssh" ]]; then
  record="${XDG_CONFIG_HOME:-$HOME/.config}/codex-apocrita/ssh-executable"
  if [[ -e "$record" ]]; then
    IFS= read -r real_ssh < "$record" || real_ssh=''
  elif [[ ! -L "$0" || "$(readlink "$0")" != */codex-apocrita/current/bin/codex-apocrita-ssh ]]; then
    # Compatibility for manually installed copies without installer state.
    real_ssh=/usr/bin/ssh
  fi
fi
if [[ "$real_ssh" != /* || ! -f "$real_ssh" || ! -x "$real_ssh" || "$real_ssh" -ef "$0" ]]; then
  printf 'codex-apocrita: Saved SSH executable is missing, invalid, or recursive. Re-run install.sh to repair it.\n' >&2
  exit 127
fi
original=("$@")
filtered=()
destination=''
removed=0

disabled_control_path() {
  local option
  option=$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]')
  # Accept OpenSSH's key=value and key value forms, not malformed keys or
  # different values that would become "none" if all whitespace were removed.
  [[ "$option" =~ ^[[:space:]]*controlpath([[:space:]]*=[[:space:]]*|[[:space:]]+)none[[:space:]]*$ ]]
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o)
      [[ $# -ge 2 ]] || exec "$real_ssh" "${original[@]}"
      if disabled_control_path "$2"; then
        removed=1
      else
        filtered+=("$1" "$2")
      fi
      shift 2
      ;;
    -o?*)
      if disabled_control_path "${1#-o}"; then
        removed=1
      else
        filtered+=("$1")
      fi
      shift
      ;;
    -[bBcDEeFIiJLlmOpQRSWw])
      [[ $# -ge 2 ]] || exec "$real_ssh" "${original[@]}"
      filtered+=("$1" "$2"); shift 2
      ;;
    -[bBcDEeFIiJLlmOpQRSWw]?*)
      filtered+=("$1"); shift
      ;;
    --)
      filtered+=("$1"); shift
      [[ $# -gt 0 ]] || exec "$real_ssh" "${original[@]}"
      destination="$1"
      break
      ;;
    -[46AaCfGgKkMNnqsTtVvXxYy])
      filtered+=("$1"); shift
      ;;
    -*)
      # Unknown/combined options: leave the entire invocation untouched.
      exec "$real_ssh" "${original[@]}"
      ;;
    *) destination="$1"; break ;;
  esac
done

if [[ "$destination" == apocrita-codex && "$removed" == 1 && "$*" == *' app-server proxy'* ]]; then
  # Remove only ControlPath=none. The alias supplies the authenticated socket.
  # Keep ControlMaster=no, reverse forwarding, BatchMode, and every other flag.
  exec "$real_ssh" "${filtered[@]}" "$@"
fi
exec "$real_ssh" "${original[@]}"
